# Copy to .env and edit.

# Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# Address the published ports bind to. Keep it on loopback unless a
# reverse proxy or firewall protects the host; SpiderFoot has no login of its
# own unless you enable OIDC or HTTP Basic auth.
BIND_ADDRESS=127.0.0.1

TZ=UTC
